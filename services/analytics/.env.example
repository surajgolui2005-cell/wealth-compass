# ==============================================================================
# Python Analytics & AI Copilot Service Configuration
# ==============================================================================

# 1. Google Gemini API Key (Get a free API key at https://aistudio.google.com/app/apikey)
COPILOT_LLM_API_KEY=your_gemini_api_key_here

# 2. Base URL (Defaults to Google Generative Language OpenAI-compatible endpoint)
COPILOT_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# 3. Model Name (e.g. gemini-1.5-flash, gemini-1.5-pro, gpt-4o-mini)
COPILOT_LLM_MODEL=gemini-1.5-flash
