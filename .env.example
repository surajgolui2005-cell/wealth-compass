# ==============================================================================
# Environment Configuration Template
# ==============================================================================
# WARNING: Values in this file are for LOCAL DEVELOPMENT ONLY.
# NEVER commit production credentials or API keys to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Application & Runtime
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
API_PORT=3000
WEB_PORT=5173
QUANT_ENGINE_PORT=8000
ADMINER_PORT=8080

# ------------------------------------------------------------------------------
# PostgreSQL Database (TimescaleDB)
# ------------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
# DEV ONLY - DO NOT USE IN PRODUCTION
POSTGRES_PASSWORD=postgres_dev_password_only
POSTGRES_DB=investor_pm
DATABASE_URL=postgresql://postgres:postgres_dev_password_only@localhost:5432/investor_pm

# ------------------------------------------------------------------------------
# Redis Cache & BullMQ Queue Store
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379

# ------------------------------------------------------------------------------
# Quant Engine Microservice (FastAPI)
# ------------------------------------------------------------------------------
QUANT_ENGINE_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# Authentication & Security Secrets
# ------------------------------------------------------------------------------
# DEV ONLY - DO NOT USE IN PRODUCTION (Must be at least 32 characters in production)
JWT_SECRET=dev_jwt_secret_key_must_be_at_least_32_characters_long_for_security
JWT_EXPIRES_IN=1d
# DEV ONLY - DO NOT USE IN PRODUCTION
JWT_REFRESH_SECRET=dev_jwt_refresh_secret_key_must_be_at_least_32_characters_long
JWT_REFRESH_EXPIRES_IN=7d
# DEV ONLY - DO NOT USE IN PRODUCTION (Must be at least 32 characters for AES-256)
ENCRYPTION_KEY_AES256=dev_aes256_secret_key_32_bytes_long_!

# ------------------------------------------------------------------------------
# Market Data & External Provider API Credentials (Optional in Dev)
# ------------------------------------------------------------------------------
ALPHA_VANTAGE_API_KEY=
COINGECKO_API_KEY=
OPEN_EXCHANGE_RATES_APP_ID=
ZERODHA_API_KEY=
ZERODHA_API_SECRET=
BINANCE_API_KEY=
BINANCE_API_SECRET=

