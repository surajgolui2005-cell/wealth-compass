{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@investor-pm/types": ["packages/shared-types/src/index.ts"],
      "@investor-pm/ui": ["packages/ui-components/src/index.ts"],
      "@investor-pm/config": ["packages/config/src/index.ts"],
      "@investor-pm/config/*": ["packages/config/*"]
    }
  },
  "exclude": ["node_modules", "dist"]
}
